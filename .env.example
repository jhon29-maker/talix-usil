# TALIX — Firebase Configuration
# Ve a https://console.firebase.google.com → Tu proyecto → Configuración → Config web
# Renombra este archivo a .env y reemplaza los valores con los de tu proyecto Firebase

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=talix-usil.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talix-usil
VITE_FIREBASE_STORAGE_BUCKET=talix-usil.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
